# Generated by `xcodegen generate` from project.yml
*.xcodeproj/
*.xcworkspace/
Config/*-Info.plist
Config/*.entitlements

# Build products
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip

# App Store Connect API keys must never be committed
*.p8
ExportOptions*.plist

# Xcode user state
xcuserdata/
*.xcuserstate

# Personal build settings and downloaded tools (scripts/run-on-iphone.sh)
Config/Local.xcconfig
.tools/
